{
  "expo": {
    "name": "Gánh Giải Trí",
    "slug": "ganh-phim",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/iconapp.png",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07113A",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "backgroundColor": "#07113A",
      "package": "com.tinph1830.ganhphim"
    },

    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-video",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/iconapp.png",
          "resizeMode": "contain",
          "backgroundColor": "#07113A"
        }
      ],
      "expo-status-bar"
    ],

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/1ca26c49-f22d-4522-941e-76debe8eecca",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "1ca26c49-f22d-4522-941e-76debe8eecca"
      }
    }
  }
}